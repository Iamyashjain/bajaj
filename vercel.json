{
  "version": 2,
  "builds": [
    {
      "src": "pom.xml",
      "use": "@vercel/java"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/",
      "methods": ["GET"]
    },
    {
      "src": "/bfhl",
      "dest": "/",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
